# ---- Core ----
NODE_ENV=development
LOG_LEVEL=info

# ---- API ----
API_PORT=4000
# Public base URL of the API, used to build tracking + unsubscribe links.
PUBLIC_API_URL=http://localhost:4000
# Comma-separated allowed CORS origins (the web app).
WEB_ORIGIN=http://localhost:5173
# Directory for uploaded template images, served read-only at PUBLIC_API_URL/uploads.
UPLOADS_DIR=.uploads

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600
# HMAC secret for signing tracked links / unsubscribe tokens.
LINK_SIGNING_SECRET=dev-link-secret-change-me

# ---- Database (MySQL — the only infrastructure this app needs) ----
# Use your local MySQL 8 server. Create the database first:
#   mysql -u root -p -e "CREATE DATABASE dispatch CHARACTER SET utf8mb4;"
DB_HOST=localhost
DB_PORT=3306
DB_NAME=dispatch
DB_USER=root
DB_PASSWORD=

# ---- Queue ----
# The job queue is a table in the database above; there is no Redis.
# How fast the worker polls each queue is fixed in code; these tune sending:

# ---- Sending ----
# mock = write to ./.mail-outbox and log (nothing is actually sent)
# smtp = send via an SMTP server (see SMTP_* below)
EMAIL_PROVIDER=mock
EMAIL_FROM="Dispatch <no-reply@example.com>"
# Physical postal address shown in the email footer (CAN-SPAM).
EMAIL_SENDER_ADDRESS=123 Example St, Example City, EX 00000
# Open pixel + click-redirect rewriting on outbound mail. Set false to send
# clean, untracked mail — best odds of the primary inbox (Gmail reads the pixel
# and redirect domain as bulk marketing), at the cost of all open/click stats.
EMAIL_TRACKING=true
# Throttle + safety cap on outbound sends. Keep these under your SMTP provider's
# own limits (Gmail: ~500/day free, ~2000/day Workspace).
SEND_RATE_PER_SEC=1
SEND_DAILY_CAP=200
SEND_MAX_ATTEMPTS=5
SEND_BACKOFF_MS=30000
# Manual bulk ("drip") send from the Contacts page waits a random gap in
# [min, max] seconds before each contact. These seed the defaults; change the
# live values in Settings → Bulk send pacing.
BULK_SEND_MIN_DELAY_SEC=8
BULK_SEND_MAX_DELAY_SEC=25
# Recurring campaign cron expressions evaluate in this timezone.
SCHEDULER_TIMEZONE=UTC

# Dev-only: make the mock provider fail a fraction of sends to exercise retry/DLQ.
MOCK_FAIL_RATE=0

# ---- SMTP (only needed when EMAIL_PROVIDER=smtp) ----
# Set EMAIL_PROVIDER=smtp above and EMAIL_FROM to your sending address.
# Gmail: enable 2-Step Verification, create an App Password at
# https://myaccount.google.com/apppasswords, and use it (no spaces) as SMTP_PASS.
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false        # 587 = STARTTLS; use 465 + true for implicit TLS
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=your16charapppw
#   EMAIL_FROM="Your Name <you@gmail.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ---------- WHATSAPP (isolated from email) ----------
# Meta WhatsApp Cloud API. These are read by config/whatsapp.ts, which is
# completely separate from the email env loader (src/env.ts). Blank/missing
# values ONLY disable WhatsApp — they never affect email sending or app startup.
# Every value can also be set (and overridden) from Settings -> WhatsApp.
WHATSAPP_PROVIDER=meta
META_WHATSAPP_ACCESS_TOKEN=           # System-user permanent token with whatsapp_business_messaging (+ _management)
META_WHATSAPP_PHONE_NUMBER_ID=        # WhatsApp Manager -> Phone numbers -> Phone number ID (not the phone number)
META_WHATSAPP_WABA_ID=                # WhatsApp Business Account ID
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=   # any random string; enter the same one in the Meta app's webhook config
META_WHATSAPP_APP_SECRET=             # Meta app -> Settings -> Basic -> App secret (signs webhook requests)
META_GRAPH_API_VERSION=v24.0
# Webhook callback URL to register in the Meta app (WhatsApp -> Configuration),
# subscribed to the "messages" field: https://<public API host>/api/webhooks/whatsapp
WHATSAPP_DEFAULT_COUNTRY_CODE=       # digits only (e.g. 1, 91) prepended to 10-digit local numbers
# Private folder for WhatsApp media: template header images / videos / documents,
# files customers send (downloaded after the webhook) and Inbox reply attachments.
# Never served publicly - only through signed-in API routes. Relative to the API's
# working directory, like UPLOADS_DIR. Optional (default .whatsapp-media).
WHATSAPP_MEDIA_DIR=.whatsapp-media
WHATSAPP_MIN_DELAY_SEC=8
WHATSAPP_MAX_DELAY_SEC=25
# After Meta refuses a marketing template to a number with 131049, bulk sends skip further
# marketing templates to that number for this many hours (0 = off). Never retried automatically;
# the contact is never changed.
WHATSAPP_131049_COOLDOWN_HOURS=24

# ---------- AI VOICE CALLS (isolated; "AI Call" on the Contacts page) ----------
# Read by apps/api/src/config/aiCalls.ts. Off unless ENABLE_AI_CALLS=true; blank
# values only disable AI calls — email / WhatsApp are never affected. Only ADMIN
# users can start calls.
ENABLE_AI_CALLS=false
# kagzso-voice-backend-english base URL and its ADMIN_API_KEY (sent as X-API-Key).
VOICE_BACKEND_URL=http://localhost:8002
VOICE_BACKEND_API_KEY=
# Which voice agent runs the call. Nila (the names Radhi and Kayal also still work) = the standard screening flow (identity →
# permission → intro → repetitive-work question); Follow-up = discuss follow_up_detail.
# VOICE_AGENT_ID (a numeric id) overrides the name when set.
VOICE_AGENT_ID=
VOICE_AGENT_NAME=Nila
# Shared secret for signed status callbacks (POST /api/webhooks/ai-calls). Put the
# same value in the voice backend's STATUS_CALLBACK_SECRET. Blank = callbacks off;
# runs still progress by polling the voice backend.
AI_CALL_WEBHOOK_SECRET=
AI_CALLS_DEFAULT_COUNTRY_CODE=91   # added to numbers without a country code
AI_CALLS_MAX_PER_RUN=10            # hard cap per run (absolute max 100)
AI_CALLS_DAILY_CAP=100             # calls per rolling 24 hours, all runs
AI_CALLS_MIN_GAP_SEC=10            # smallest allowed gap between calls
AI_CALLS_CALL_TIMEOUT_SEC=900      # a call with no final status after this is marked failed
AI_CALL_FOLLOWUP_MAX_RETRIES=2     # AI Call Customers: max "call again" drafts after No answer
# "Call Flows" page (edit the voice agent's script in the UI) + flow picker in the
# AI Call window. Needs ENABLE_AI_CALLS=true too. Off = every call uses the default
# agent above, exactly as before.
ENABLE_CALL_FLOW_EDITOR=false
# OPTIONAL. Admins add trial numbers for "Test call to my number" in the popup
# itself (Call Flows page, up to 5). Numbers listed here (comma-separated E.164,
# e.g. +919876543210) are allowed as well — a fallback that needs no database
# change. Leave empty to manage trial numbers only in the UI.
AI_CALL_FLOW_TEST_NUMBERS=

# ---- Observability ----
SENTRY_DSN=

# ---- Seed safety (npm run db:seed / db:seed:plan) ----
# The seed refuses to run unless the connected database (SELECT DATABASE())
# equals SEED_EXPECTED_DATABASE. Writing additionally requires
# ALLOW_DATABASE_SEED=true — set it only for the run, then back to false.
# `npm run db:seed:plan` prints what would be created/skipped and writes nothing.
SEED_EXPECTED_DATABASE=
ALLOW_DATABASE_SEED=false

# ---- Bootstrap admin (created by npm run db:seed) ----
SEED_ADMIN_EMAIL=admin@kagzso.com
SEED_ADMIN_PASSWORD=Admin@123
# The seed only creates this admin if the email doesn't exist yet; it never
# changes an existing user's password unless SEED_ADMIN_RESET=true (one-off
# recovery — unset it again afterwards).
SEED_ADMIN_RESET=true
