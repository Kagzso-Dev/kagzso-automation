// Dispatch — single-organization email automation platform.
// See docs/technical-design.html §4 for the model rationale.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- auth

enum Role {
  ADMIN
  EDITOR
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(EDITOR)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ApiKey {
  id        String    @id @default(cuid())
  name      String
  keyHash   String    @unique // sha-256 of the raw key, used for auth lookups
  rawKey    String?   @db.Text // full raw key, stored so admins can reveal/copy it later; null for keys created before this was added
  prefix    String // first 10 chars of the raw key, for display
  lastUsed  DateTime?
  createdAt DateTime  @default(now())
}

// ---------------------------------------------------------------- audience

enum ContactStatus {
  ACTIVE
  UNSUBSCRIBED
  BOUNCED
  COMPLAINED
}

model Contact {
  id           String           @id @default(cuid())
  email        String           @unique
  firstName    String?
  lastName     String?
  phone        String?
  businessName String?
  customFields Json
  status       ContactStatus    @default(ACTIVE)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  memberships  ListMembership[]
  emailLogs    EmailLog[]
  unsubscribe  Unsubscribe?
}

// Approved recipient domains. When the table is empty there is no restriction;
// when it has rows, a contact may only be emailed if its address domain matches
// one. Enforced at import time and again at send time (see domain/allowedDomains).
model AllowedDomain {
  id        String   @id @default(cuid())
  domain    String   @unique // bare, lowercased, no leading '@' — e.g. "gmail.com"
  createdAt DateTime @default(now())
}

model List {
  id          String           @id @default(cuid())
  name        String
  description String?          @db.VarChar(1000)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  members     ListMembership[]
  campaigns   Campaign[]
}

model ListMembership {
  listId    String
  contactId String
  addedAt   DateTime @default(now())
  list      List     @relation(fields: [listId], references: [id], onDelete: Cascade)
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@id([listId, contactId])
  @@index([contactId])
}

// ---------------------------------------------------------------- content

enum TemplateKind {
  LETTER
  MEETING
}

model Template {
  id        String       @id @default(cuid())
  name      String
  kind      TemplateKind @default(LETTER)
  subject   String       @db.VarChar(300)
  bodyText  String?      @db.LongText // the message as a plain letter (paragraphs + {{vars}})
  signature String?      @db.Text // closing / regards block, appended after the body
  htmlBody  String       @db.LongText // render-ready HTML, derived from bodyText; sanitised at render time
  textBody  String?      @db.Text
  // Call-to-action links rendered as a button panel after the body:
  // [{ label, url }]. `url` may contain {{variables}}.
  links     Json?
  // Structured meeting details, rendered as a card with calendar links when
  // kind = MEETING: { title?, location?, joinUrl?, startAt?, endAt?, timezone?,
  // description? }. Date fields accept an ISO 8601 string or a {{variable}}.
  meeting   Json?
  // Legacy single image / video fields, kept for older templates. New edits use
  // `images` / `videos`; the renderer merges these ahead of those arrays.
  imageUrl  String?      @db.VarChar(2000)
  videoUrl  String?      @db.VarChar(2000)
  // Images embedded in the body: ["https://…/a.jpg", …]. Placed at {{image}},
  // {{image_2}} … placeholders, else stacked at the top of the body.
  images    Json?
  // "▶ Watch video" buttons: [{ url, label? }, …]. Placed at {{video_link}},
  // {{video_link_2}} … placeholders, else appended after the body.
  videos    Json?
  variables Json // declared variable names for the editor helper
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  campaigns Campaign[]
  triggers  Trigger[]
  manualBatches ManualSendBatch[]
}

// ---------------------------------------------------------------- scheduled sends

enum ScheduleType {
  ONCE
  RECURRING
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  PAUSED
  FAILED
}

model Campaign {
  id             String         @id @default(cuid())
  name           String
  templateId     String
  listId         String
  scheduleType   ScheduleType
  sendAt         DateTime? // for ONCE
  cronExpression String? // for RECURRING
  status         CampaignStatus @default(DRAFT)
  lastRunAt      DateTime? // occurrence cursor for RECURRING; last dispatch for ONCE
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  template       Template       @relation(fields: [templateId], references: [id])
  list           List           @relation(fields: [listId], references: [id])
  emailLogs      EmailLog[]

  @@index([templateId])
  @@index([listId])
}

// ---------------------------------------------------------------- event-triggered sends

model Trigger {
  id         String     @id @default(cuid())
  name       String
  eventKey   String     @unique // path segment of the webhook URL
  templateId String
  conditions Json // array of { field, op, value } predicates on the payload
  active     Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  template   Template   @relation(fields: [templateId], references: [id])
  emailLogs  EmailLog[]

  @@index([templateId])
}

// ---------------------------------------------------------------- the ledger

enum EmailStatus {
  QUEUED
  SENT
  DELIVERED
  OPENED
  CLICKED
  BOUNCED
  COMPLAINED
  FAILED
}

model EmailLog {
  id                String      @id @default(cuid())
  campaignId        String?
  triggerId         String?
  contactId         String
  idempotencyKey    String      @unique
  status            EmailStatus @default(QUEUED)
  providerMessageId String?
  subject           String?     @db.VarChar(300)
  errorMessage      String?     @db.Text
  deliveredAt       DateTime?
  failedAt          DateTime?
  openedAt          DateTime?
  clickedAt         DateTime?
  sentAt            DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  campaign          Campaign?   @relation(fields: [campaignId], references: [id])
  trigger           Trigger?    @relation(fields: [triggerId], references: [id])
  contact           Contact     @relation(fields: [contactId], references: [id])

  @@index([campaignId, status])
  @@index([triggerId, status])
  @@index([contactId])
  @@index([providerMessageId])
}

model Unsubscribe {
  id        String   @id @default(cuid())
  contactId String   @unique
  reason    String?  @db.Text
  token     String   @unique // opaque token embedded in the unsubscribe link
  createdAt DateTime @default(now())
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------- key-value settings

// Small operator-tunable settings that would otherwise be hardcoded or env-only.
// One row per setting; `value` is JSON so a setting can hold a small object.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------- manual drip sends

enum ManualBatchStatus {
  RUNNING
  DONE
  CANCELLED
}

enum ManualBatchItemStatus {
  PENDING
  SENDING
  SENT
  FAILED
  SKIPPED
}

// A "send this template to N selected contacts, one at a time with a random gap"
// job kicked off from the Contacts page. The orchestrator job in the
// `manual-bulk-send` queue walks the items one per iteration (see
// queue/manualBulkSend.ts). Delays are snapshotted at creation so a mid-flight
// Settings change never alters a running batch.
model ManualSendBatch {
  id          String                @id @default(cuid())
  templateId  String
  minDelaySec Int
  maxDelaySec Int
  status      ManualBatchStatus     @default(RUNNING)
  total       Int
  nextItemAt  DateTime? // when the next send is scheduled — drives the "next in Ns" countdown
  retryOfId   String? // set when this batch is a "retry failed" of an earlier one
  // Lead-generation flow: when true, contacts this batch emailed successfully
  // (item SENT) are deleted once the batch finishes. Failed / skipped are kept.
  purgeAfter  Boolean               @default(false)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  template    Template              @relation(fields: [templateId], references: [id])
  items       ManualSendBatchItem[]

  @@index([status])
}

model ManualSendBatchItem {
  id        String                @id @default(cuid())
  batchId   String
  contactId String
  email     String // snapshot, so the row still reads if the contact is later deleted
  name      String? // snapshot "First Last", so the Send Queue detail still reads after a purge
  status    ManualBatchItemStatus @default(PENDING)
  error     String?               @db.Text
  sentAt    DateTime?
  // The EmailLog row this send produced — lets the Send Queue detail show the
  // per-recipient delivered / opened times without guessing the join.
  emailLogId String?
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  batch     ManualSendBatch       @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId, status])
}

// ---------------------------------------------------------------- whatsapp (isolated from email)
// A parallel, self-contained WhatsApp capability. It shares nothing with the
// email models above — its own contacts, templates, batches and ledger — so
// changes here cannot affect email Contacts / Templates / Campaigns / sending.
// See docs + apps/api/src/{config,services}/whatsapp.ts.

enum WhatsAppContactStatus {
  ACTIVE
  UNSUBSCRIBED
  BLOCKED
}

model WhatsAppContact {
  id           String                @id @default(cuid())
  phone        String                @unique // E.164 digits, no '+' or punctuation
  firstName    String?
  lastName     String?
  businessName String?
  status       WhatsAppContactStatus @default(ACTIVE)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  sends        WhatsAppSend[]
  inbound      WhatsAppInboundMessage[]

  @@map("whatsapp_contacts")
}

model WhatsAppTemplate {
  id                   String              @id @default(cuid())
  name                 String // display name in this app
  // Exact name of the Meta-approved message template (WhatsApp Manager →
  // Message templates). Null on templates registered before the move to the
  // Meta Cloud API — they must be given one before they can be sent.
  providerTemplateName String?             @db.VarChar(512)
  languageCode         String              @default("en") @db.VarChar(16) // Meta template language, e.g. en, en_US
  // Pre-Meta provider template id (Twilio Content SID, HX…). Kept read-only so
  // existing rows aren't lost; nothing sends with it any more.
  legacyContentSid     String?             @map("contentSid")
  body                 String              @db.Text // preview text with {{first_name}} etc.
  variables            Json                // ordered string[] → positional template params {{1}}, {{2}}
  buttonLabels         Json                // string[] e.g. ["Interested", "Not Interested"]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  batches      WhatsAppSendBatch[]

  @@map("whatsapp_templates")
}

enum WhatsAppBatchStatus {
  RUNNING
  DONE
  CANCELLED
}

// A "send this template to N selected recipients, one at a time with a random
// gap" job. Mirrors ManualSendBatch but for WhatsApp; walked by the
// `whatsapp-bulk-send` queue worker (see queue/whatsappBulkSend.ts).
model WhatsAppSendBatch {
  id          String              @id @default(cuid())
  templateId  String
  minDelaySec Int
  maxDelaySec Int
  status      WhatsAppBatchStatus @default(RUNNING)
  total       Int
  nextItemAt  DateTime? // when the next send is scheduled — drives the "next in Ns" countdown
  // Lead-generation flow: when true, recipients whose message Meta confirms as
  // DELIVERED / READ are deleted (at batch end, or when the confirmation arrives
  // later). Failed and skipped recipients are never deleted.
  purgeAfter  Boolean             @default(false)
  purgeTable  String?             @db.VarChar(16) // "whatsapp" | "contact": which table purgeIds are in
  purgeIds    Json? // contact ids this batch may delete (string[])
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  template    WhatsAppTemplate    @relation(fields: [templateId], references: [id])
  items       WhatsAppSend[]

  @@index([status])
  @@map("whatsapp_send_batches")
}

enum WhatsAppSendStatus {
  QUEUED
  SENDING
  SENT
  DELIVERED
  READ
  FAILED
  SKIPPED
}

// One WhatsApp message. Also the send ledger (phone/name/business/status/times).
model WhatsAppSend {
  id                String             @id @default(cuid())
  batchId           String?
  whatsappContactId String?
  templateId        String?
  phone             String // snapshot, survives contact deletion
  name              String? // snapshot "First Last"
  businessName      String? // snapshot
  body              String             @db.Text // rendered preview snapshot
  contentVariables  Json? // resolved positional template params ({"1": "Ada"}), snapshotted at batch creation
  status            WhatsAppSendStatus @default(QUEUED)
  provider          String             @default("meta") @db.VarChar(16) // who actually sent it
  providerMessageId String? // Meta message id (wamid.…)
  errorCode         String?            @db.VarChar(32)
  error             String?            @db.Text
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  failedAt          DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  batch             WhatsAppSendBatch? @relation(fields: [batchId], references: [id], onDelete: Cascade)
  contact           WhatsAppContact?   @relation(fields: [whatsappContactId], references: [id], onDelete: SetNull)

  @@index([batchId, status])
  @@index([providerMessageId])
  @@map("whatsapp_sends")
}

// A message a recipient sent to our WhatsApp number, received through the Meta
// webhook (POST /api/webhooks/whatsapp). Unique on providerMessageId so Meta's
// redelivery of the same event is a no-op.
model WhatsAppInboundMessage {
  id                String           @id @default(cuid())
  provider          String           @default("meta") @db.VarChar(16)
  providerMessageId String           @unique // Meta message id (wamid.…)
  phone             String           @db.VarChar(32) // sender, digits with country code
  profileName       String? // sender's WhatsApp profile name
  whatsappContactId String?
  messageType       String           @db.VarChar(32) // text, image, button, interactive, …
  body              String?          @db.Text // text body, media caption or reply title
  mediaId           String? // Meta media id — fetch via the Graph API
  mediaMimeType     String?
  replyPayload      String?          @db.Text // quick-reply button payload / interactive reply id
  contextMessageId  String? // id of our outbound message this replies to
  sentAt            DateTime // Meta's timestamp for the message
  raw               Json
  createdAt         DateTime         @default(now())
  contact           WhatsAppContact? @relation(fields: [whatsappContactId], references: [id], onDelete: SetNull)

  @@index([phone])
  @@index([contextMessageId])
  @@map("whatsapp_inbound_messages")
}

// ---------------------------------------------------------------- job queue (MySQL-backed)

enum JobStatus {
  PENDING
  ACTIVE
  COMPLETED
  FAILED
  DEAD
}

model Job {
  id          String    @id @default(cuid())
  queue       String
  payload     Json
  status      JobStatus @default(PENDING)
  runAt       DateTime  @default(now())
  attempts    Int       @default(0)
  maxAttempts Int       @default(1)
  dedupeKey   String?   @unique // repeat enqueues with the same key are no-ops
  result      Json? // processor return value, for observability
  lastError   String?   @db.Text
  lockedAt    DateTime?
  lockedBy    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([queue, status, runAt])
}

// ---------------------------------------------------------------- AI voice calls (isolated)
// Outbound AI calls started from the Contacts page ("AI Call"). Customers come
// from an uploaded file, not from the Contact table, and each call is placed
// by the kagzso-voice-backend service. Shares nothing with the email or
// WhatsApp models. Walked one call at a time by the `ai-call-run` queue
// worker (see queue/aiCallRun.ts).

enum AiCallRunStatus {
  RUNNING
  DONE
  CANCELLED
}

enum AiCallMode {
  RANDOM
  SELECTED
  ALL
}

enum AiCallStatus {
  QUEUED // not dialled yet
  DIALING // handed to the voice backend
  RINGING
  IN_PROGRESS
  COMPLETED
  NO_ANSWER
  BUSY
  FAILED
  CANCELLED // run cancelled before this call was placed
}

model AiCallRun {
  id             String          @id @default(cuid())
  mode           AiCallMode
  status         AiCallRunStatus @default(RUNNING)
  gapSeconds     Int
  maxCalls       Int
  total          Int
  createdById    String?
  createdByEmail String?
  // What was dropped at start: { invalid, duplicates, doNotCall, capped }.
  skipped        Json?
  nextCallAt     DateTime? // when the next call is due — drives the countdown
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  logs           AiCallLog[]
  flow           AiCallRunFlow? // pinned call flow version (none = the default agent)

  @@index([status])
  @@map("ai_call_runs")
}

model AiCallLog {
  id             String       @id @default(cuid())
  runId          String
  position       Int // call order within the run
  customerName   String?
  gender         String?      @db.VarChar(16) // male | female | unknown
  followUpDetail String?      @db.Text
  phone          String       @db.VarChar(20) // E.164
  status         AiCallStatus @default(QUEUED)
  voiceCallId    String?      @db.VarChar(64) // call id in kagzso-voice-backend
  providerCallId String?      @db.VarChar(64) // Plivo / Twilio call id
  outcome        String?      @db.VarChar(32) // interested, not_interested, callback_requested, …
  error          String?      @db.Text
  durationSec    Int?
  transcript     String?      @db.LongText
  summary        String?      @db.Text
  startedAt      DateTime?
  endedAt        DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  run            AiCallRun    @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, position])
  @@index([voiceCallId])
  @@index([phone])
  @@map("ai_call_logs")
}

// Call Flows: the UI-editable form of a voice agent's script ("Call Flows" page,
// behind ENABLE_CALL_FLOW_EDITOR). The definition JSON is validated by the voice
// backend (app/flows/schema.py) and mirrored in packages/shared/src/callFlows.ts.
// A flow has at most one DRAFT; PUBLISHED versions are never updated.

enum CallFlowVersionStatus {
  DRAFT
  PUBLISHED
}

model CallFlow {
  id             String            @id @default(cuid())
  name           String            @db.VarChar(100)
  description    String?           @db.Text
  base           String            @db.VarChar(16) // built-in it was copied from: nila | followup
  archivedAt     DateTime?
  createdById    String?
  createdByEmail String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  versions       CallFlowVersion[]

  @@map("call_flows")
}

model CallFlowVersion {
  id             String                @id @default(cuid())
  flowId         String
  version        Int
  status         CallFlowVersionStatus @default(DRAFT)
  definition     Json
  definitionHash String                @db.VarChar(64) // sha-256 of the definition JSON, for audit
  createdByEmail String?
  publishedAt    DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  flow           CallFlow              @relation(fields: [flowId], references: [id], onDelete: Cascade)
  runs           AiCallRunFlow[]

  @@unique([flowId, version])
  @@map("call_flow_versions")
}

// Pins one AI call run to the flow version it was started with (separate table
// so ai_call_runs is not altered). No row = the run uses the default agent.
model AiCallRunFlow {
  runId         String          @id
  flowVersionId String
  createdAt     DateTime        @default(now())
  run           AiCallRun       @relation(fields: [runId], references: [id], onDelete: Cascade)
  flowVersion   CallFlowVersion @relation(fields: [flowVersionId], references: [id], onDelete: Restrict)

  @@index([flowVersionId])
  @@map("ai_call_run_flows")
}

// Trial numbers the "Test call to my number" popup may dial (added by admins in
// the UI; AI_CALL_FLOW_TEST_NUMBERS still works alongside). Removing one sets
// deletedAt; adding the same number again brings that row back.
model AiCallTestNumber {
  id        String    @id @default(cuid())
  phone     String    @unique @db.VarChar(20) // E.164, e.g. +919876543210
  label     String?   @db.VarChar(60)
  createdBy String    @db.VarChar(191) // admin email
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@map("ai_call_test_numbers")
}

// ---------------------------------------------------------------- AI Call Customers (isolated)
// Saved customers for AI voice calls ("AI Call Customers" tab on the Contacts
// page), their call stage, a timeline, and follow-ups that wait for admin
// approval before anything is sent. New tables only: nothing here alters the
// email, WhatsApp or ai_call_* tables. See apps/api/src/domain/aiCallCustomers.ts.

enum AiCallCustomerStage {
  NOT_CALLED
  QUEUED
  CALLING
  NO_ANSWER
  FAILED
  INTERESTED
  NOT_INTERESTED
  FOLLOW_UP_NEEDED
  CALLBACK_REQUESTED
  DO_NOT_CALL
  APPROVED
  REJECTED
}

model AiCallCustomer {
  id             String              @id @default(cuid())
  customerName   String?             @db.VarChar(100)
  gender         String              @default("male") @db.VarChar(16) // male | female (CHECK in migration 0026)
  phone          String              @db.VarChar(20) // E.164, e.g. +919876543210
  // Same as `phone` while the row is live, null once soft-deleted: a unique
  // index on it = "one live customer per number" (MySQL has no partial index).
  activePhone    String?             @unique @db.VarChar(20)
  businessName   String?             @db.VarChar(160)
  followUpDetail String?             @db.Text
  email          String?             @db.VarChar(191) // stored for reference; no email is sent from here
  whatsappOptIn  Boolean             @default(false)
  stage          AiCallCustomerStage @default(NOT_CALLED)
  // Set when the stage came from a call result and an admin has not reviewed it yet.
  needsReview    Boolean             @default(false)
  // Permanent: once true, never cleared by the app (the number is never called again).
  doNotCall      Boolean             @default(false)
  lastCallLogId  String?             @db.VarChar(191)
  lastCalledAt   DateTime?
  createdByEmail String?
  deletedAt      DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  calls          AiCallCustomerCall[]
  events         AiCallCustomerEvent[]
  followups      AiCallFollowup[]

  @@index([deletedAt, stage])
  @@index([phone])
  @@map("ai_call_customers")
}

// Links one ai_call_logs row to the saved customer it called (ai_call_logs is not altered).
model AiCallCustomerCall {
  logId      String         @id @db.VarChar(191)
  customerId String
  createdAt  DateTime       @default(now())
  customer   AiCallCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("ai_call_customer_calls")
}

// Timeline / stage history: call, outcome, stage change, follow-up created, approved, …
model AiCallCustomerEvent {
  id         String         @id @default(cuid())
  customerId String
  type       String         @db.VarChar(32)
  stage      AiCallCustomerStage?
  detail     String?        @db.Text
  refId      String?        @db.VarChar(191) // call log / follow-up id
  actorEmail String?
  createdAt  DateTime       @default(now())
  customer   AiCallCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
  @@map("ai_call_customer_events")
}

enum AiCallFollowupChannel {
  WHATSAPP
  CALL
}

enum AiCallFollowupStatus {
  PENDING_APPROVAL
  APPROVED // handed to the existing WhatsApp batch / AI call run
  REJECTED
  CANCELLED // superseded (e.g. the customer became Not interested / Do not call)
  FAILED // could not be handed over (shown with `error`)
}

// One follow-up waiting in Send Queue → "AI Call follow-ups". Nothing is sent
// until an admin approves it; approval creates a normal WhatsApp batch or AI
// call run, so the existing workers, templates, limits and retries apply.
model AiCallFollowup {
  id                 String                @id @default(cuid())
  customerId         String
  channel            AiCallFollowupChannel
  status             AiCallFollowupStatus  @default(PENDING_APPROVAL)
  reason             String?               @db.VarChar(64) // stage that created it, e.g. "Interested"
  whatsappTemplateId String?               @db.VarChar(191)
  scheduledAt        DateTime? // CALL: when to call again
  attempt            Int                   @default(1) // CALL: retry number
  note               String?               @db.Text
  sourceCallLogId    String?               @db.VarChar(191)
  whatsappBatchId    String?               @db.VarChar(191)
  aiCallRunId        String?               @db.VarChar(191)
  error              String?               @db.Text
  createdByEmail     String? // null = created automatically after a call
  decidedByEmail     String?
  decidedAt          DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  customer           AiCallCustomer        @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([customerId])
  @@map("ai_call_followups")
}

// ---------------------------------------------------------------- WhatsApp media (isolated)
// Files sent / received over WhatsApp: template header media (image, video,
// document), media in customer messages (downloaded after the webhook), and
// attachments on Inbox replies. New tables only — whatsapp_templates,
// whatsapp_sends and whatsapp_inbound_messages are not altered. Files live in
// WHATSAPP_MEDIA_DIR (private, never served statically). See domain/whatsappMedia.ts.

enum WhatsAppMediaPurpose {
  INBOUND // from a customer's message
  TEMPLATE_HEADER // header image / video / document of a registered template
  REPLY // attachment on an Inbox reply
}

enum WhatsAppMediaStatus {
  PENDING // inbound: waiting for download
  STORED
  FAILED
  EXPIRED // inbound: Meta no longer has the media
}

model WhatsAppMedia {
  id               String               @id @default(cuid())
  purpose          WhatsAppMediaPurpose
  kind             String               @db.VarChar(16) // image | video | audio | document | sticker
  status           WhatsAppMediaStatus  @default(PENDING)
  mimeType         String?              @db.VarChar(128)
  filename         String?              @db.VarChar(255) // display name only, never a path
  sizeBytes        Int?
  sha256           String?              @db.VarChar(64)
  storageKey       String?              @db.VarChar(128) // file name inside WHATSAPP_MEDIA_DIR
  providerMediaId  String?              @db.VarChar(128) // Meta media id (inbound, or our last upload)
  providerMediaAt  DateTime? // when providerMediaId was issued (uploads expire after 30 days)
  inboundMessageId String?              @unique @db.VarChar(191)
  attempts         Int                  @default(0)
  error            String?              @db.Text
  createdByEmail   String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  templateHeaders  WhatsAppTemplateHeaderMedia[]
  sends            WhatsAppSendMedia[]

  @@index([purpose, status])
  @@map("whatsapp_media")
}

// The header media a template is sent with (one per template).
model WhatsAppTemplateHeaderMedia {
  templateId     String        @id @db.VarChar(191)
  mediaId        String
  updatedByEmail String?
  updatedAt      DateTime      @updatedAt
  media          WhatsAppMedia @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@index([mediaId])
  @@map("whatsapp_template_header_media")
}

// Which media a sent message carried (history), keyed by whatsapp_sends.id.
model WhatsAppSendMedia {
  sendId    String        @id @db.VarChar(191)
  mediaId   String
  role      String        @db.VarChar(16) // header | attachment
  createdAt DateTime      @default(now())
  media     WhatsAppMedia @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@index([mediaId])
  @@map("whatsapp_send_media")
}

// WhatsApp Inbox read state: when someone last read each conversation. A
// customer message is unread if it arrived after lastReadAt (or there is no
// row yet). New table only — whatsapp_inbound_messages is not altered.
model WhatsAppConversationRead {
  phone       String   @id @db.VarChar(32) // digits with country code, as in whatsapp_inbound_messages.phone
  lastReadAt  DateTime
  readByEmail String?
  updatedAt   DateTime @updatedAt

  @@map("whatsapp_conversation_reads")
}

// Meta's pricing info for a message we sent, from the status webhook
// (statuses[].pricing: billable, category, pricing_model). Used only by the
// Dashboard cost estimate; the amount always comes from the rate card in
// Settings. Keyed by the Meta message id (whatsapp_sends.providerMessageId).
// New table only — whatsapp_sends is not altered.
model WhatsAppMessagePricing {
  providerMessageId String   @id @db.VarChar(191)
  billable          Boolean?
  category          String?  @db.VarChar(64)
  pricingModel      String?  @db.VarChar(32)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("whatsapp_message_pricing")
}

// Settings → Branding: display-only app name (sidebar header, browser tab) an
// admin changed. Key-value so more display names can be added later. Only
// changed keys have a row; no row (or no table) means the default "Dispatch". updatedBy is the admin's user id.
// New table only — no existing table is altered.
model BrandingSetting {
  key       String   @id @db.VarChar(64)
  value     String   @db.VarChar(64)
  updatedBy String   @db.VarChar(191)
  updatedAt DateTime @updatedAt

  @@map("branding_settings")
}

// ---------------------------------------------------------------- Data Quality (staging only)
// Admin page "Data Quality": an uploaded file is checked (phone, duplicates, do-not-call,
// not interested, wrong person, name / business / email) and optionally scored by the local
// Ollama server. Rows live only in these two tables until an admin approves them; nothing here
// writes to contacts, WhatsApp contacts, AI call customers, queues, flows or history.
// New tables only — no existing table is altered (rollback: 0027_data_quality/down.sql).
enum DataQualityJobStatus {
  RUNNING
  PAUSED
  CANCELLED
  DONE
}

enum DataQualityRecordStatus {
  VALID
  INVALID
  DUPLICATE
  EXCLUDED
}

enum DataQualityReview {
  PENDING
  APPROVED
  REJECTED
}

model DataQualityJob {
  id             String               @id @default(cuid())
  filename       String               @db.VarChar(200)
  status         DataQualityJobStatus @default(RUNNING)
  // Detected columns: { name, phone, business, email } → header in the file (or null).
  mapping        Json
  // Every header of the uploaded file, in order. Null for files uploaded before 0028.
  headers        Json?
  total          Int                  @default(0)
  valid          Int                  @default(0)
  invalid        Int                  @default(0)
  duplicates     Int                  @default(0)
  excluded       Int                  @default(0)
  // AI scoring by the local Ollama server: pending | done | unavailable | cancelled.
  aiStatus       String               @default("pending") @db.VarChar(16)
  aiModel        String?              @db.VarChar(100)
  aiDone         Int                  @default(0)
  aiFailures     Int                  @default(0)
  // Why AI scoring stopped or never ran ("Ollama not available: ...").
  note           String?              @db.VarChar(300)
  // Set while the job waits on its own (live AI calls are running); cleared when it goes on.
  waitingReason  String?              @db.VarChar(200)
  // Changes on every start / resume: a queued run carrying an older token stops (no double runs).
  runToken       String?              @db.VarChar(40)
  createdByEmail String?              @db.VarChar(191)
  finishedAt     DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  records        DataQualityRecord[]

  @@index([createdAt])
  @@map("data_quality_jobs")
}

model DataQualityRecord {
  id             String                  @id @default(cuid())
  jobId          String
  rowIndex       Int // 0-based data row in the uploaded file
  name           String?                 @db.VarChar(160)
  phoneRaw       String?                 @db.VarChar(64)
  phone          String?                 @db.VarChar(20) // E.164, null when the number is not usable
  businessName   String?                 @db.VarChar(200)
  email          String?                 @db.VarChar(191)
  status         DataQualityRecordStatus
  // do_not_call | not_interested | wrong_person (EXCLUDED rows only; they are never scored).
  excludedReason String?                 @db.VarChar(32)
  issues         Json // string[] of issue codes (bad_phone, missing_name, …)
  flags          Json // string[] of notes that are not problems (in_voicecall, in_whatsapp, …)
  ruleScore      Int? // 0-100 from the standard checks; VALID rows only
  // PENDING → DONE | ERROR | SKIPPED; NONE for rows that are never sent to Ollama.
  aiState        String                  @default("NONE") @db.VarChar(16)
  aiScore        Int?
  aiNotes        String?                 @db.VarChar(500)
  review         DataQualityReview       @default(PENDING)
  // The whole original row { header: text }, for the filters and the filtered export.
  // Null for files uploaded before 0028 (only the mapped columns above were kept then).
  raw            Json?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  job            DataQualityJob          @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, rowIndex])
  @@index([jobId, status])
  @@index([jobId, aiState])
  @@map("data_quality_records")
}

// One filtered export from Data Quality: who, when, which file, the filters, the columns and the
// row count. Holds no contact data (text searches are stored as "[search]", never their text).
model DataQualityExportLog {
  id              String   @id @default(cuid())
  jobId           String // no relation: the log outlives a removed job
  filename        String   @db.VarChar(200)
  byEmail         String?  @db.VarChar(191)
  format          String   @db.VarChar(8) // csv | xlsx
  filters         Json
  columns         Json // string[] of column keys
  includeExcluded Boolean  @default(false)
  rowCount        Int
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@map("data_quality_export_logs")
}
