{
  "name": "email-automation-platform",
  "private": true,
  "version": "0.1.0",
  "description": "Dispatch — scheduled + event-triggered outbound email platform (single org).",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "predev": "node scripts/predev.mjs",
    "dev": "npm-run-all --parallel dev:api dev:worker dev:web dev:voice dev:ollama",
    "dev:kill": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/free-ports.ps1",
    "dev:api": "npm run dev --workspace @dispatch/api",
    "dev:worker": "npm run dev:worker --workspace @dispatch/api",
    "dev:web": "npm run dev --workspace @dispatch/web",
    "dev:voice": "node scripts/dev-voice.mjs",
    "dev:ollama": "node scripts/dev-ollama.mjs",
    "build": "npm run build --workspace @dispatch/web",
    "prod": "node scripts/prod-deploy.mjs",
    "prisma:generate": "node scripts/prisma.mjs generate",
    "prisma:migrate": "node scripts/prisma.mjs migrate dev",
    "prisma:deploy": "node scripts/prisma.mjs migrate deploy",
    "prisma:studio": "node scripts/prisma.mjs studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:plan": "tsx prisma/seed.ts --dry-run",
    "contacts:restore:plan": "tsx prisma/restoreFailedContacts.ts",
    "contacts:restore": "tsx prisma/restoreFailedContacts.ts --apply",
    "followups:interested:plan": "tsx prisma/cancelInterestedFollowups.ts",
    "followups:interested": "tsx prisma/cancelInterestedFollowups.ts --apply",
    "followups:positive:plan": "tsx prisma/cancelInterestedFollowups.ts",
    "followups:positive": "tsx prisma/cancelInterestedFollowups.ts --apply",
    "callflow:import:plan": "tsx prisma/importCallFlow.ts",
    "callflow:import": "tsx prisma/importCallFlow.ts --apply",
    "seed": "npm run db:seed",
    "test": "npm run test --workspace @dispatch/api",
    "typecheck": "npm-run-all typecheck:*",
    "typecheck:api": "tsc -p apps/api/tsconfig.json --noEmit",
    "typecheck:web": "tsc -p apps/web/tsconfig.json --noEmit"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "npm-run-all": "^4.1.5",
    "prisma": "^5.17.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  },
  "engines": {
    "node": ">=20"
  }
}
