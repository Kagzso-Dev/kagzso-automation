# ===== Kagzso Voice Backend - copy to .env and fill in. NEVER commit .env =====
APP_NAME=Kagzso Voice Backend
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Protects /api/calls, /api/agents and /api/test (send as header X-API-Key). Min 16 chars.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=
# Signs the media WebSocket URL given to Plivo. Min 32 chars. Generate the same way.
APP_SECRET_KEY=
# Comma-separated browser origins allowed to call the API (empty = none; frontend comes later)
CORS_ORIGINS=
RATE_LIMIT_PER_MINUTE=30

# ----- Dispatch status callbacks ("AI Call" on the Dispatch Contacts page) -----
# Calls placed with run_id/log_id POST status, outcome, summary and transcript here.
# Leave empty to disable (Dispatch then polls GET /api/calls/{id} instead).
STATUS_CALLBACK_URL=
# Same value as AI_CALL_WEBHOOK_SECRET in the Dispatch .env (min 16 chars).
STATUS_CALLBACK_SECRET=

# ----- Phone provider: plivo | twilio -----
TELEPHONY_PROVIDER=plivo

# ----- Twilio -----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Twilio voice number (or verified caller ID) in E.164, e.g. +1415xxxxxxx
TWILIO_FROM_NUMBER=
# Validate X-Twilio-Signature on webhooks (keep true)
TWILIO_VALIDATE_SIGNATURE=true
# Answering-machine detection (async)
TWILIO_MACHINE_DETECTION=true

# ----- Plivo -----
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
# Your Plivo voice-enabled number in E.164, e.g. +918035xxxxxx
PLIVO_FROM_NUMBER=
# Validate X-Plivo-Signature-V3 on webhooks (keep true)
PLIVO_VALIDATE_SIGNATURE=true

# Public HTTPS URL that reaches this server (your ngrok URL), no trailing slash
PUBLIC_BASE_URL=
# /ready proves the URL really reaches this server (it calls itself through it, at most once a
# minute) and Dispatch won't start calls while it doesn't (e.g. ngrok stopped). false = only check it is set.
PUBLIC_URL_CHECK=true

# ----- Sarvam STT -----
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
# saaras:v3 only: transcribe | translate | verbatim | translit | codemix
SARVAM_STT_MODE=codemix
# Calls with a flow in "Pure" language style use this mode instead (e.g. transcribe). Empty = SARVAM_STT_MODE for all.
SARVAM_STT_MODE_PURE=
# Speech-to-text accuracy (Sarvam only). Recommended after testing: SARVAM_STT_MODEL=saaras:v4 with the
# keyterms below. Words Sarvam should expect (saaras:v4 only, comma-separated, max 50); empty = none.
STT_KEYTERMS=
# e.g. STT_KEYTERMS=Kexo,Kagzso,Kexo AI and Automation,UiPath,automation,WhatsApp,kagzso.com,Power Platform
# If a request with SARVAM_STT_MODEL fails, try once with this model (ignored when it's the same; empty = off).
STT_FALLBACK_MODEL=saaras:v3
# Send STT a level-normalised copy of the customer's audio (soft voices lifted, loud never clipped).
# The live call audio, speech detection, barge-in and recordings are unchanged.
STT_NORMALIZE_AUDIO=false
STT_NORMALIZE_TARGET_RMS=3000
STT_NORMALIZE_MAX_GAIN_DB=12
# Log each STT request's time and model (never audio, numbers or keys).
STT_TIMING_LOG=true

# ----- Text to speech: Sarvam Bulbul (uses SARVAM_API_KEY above and CALL_LANGUAGE) -----
SARVAM_TTS_MODEL=bulbul:v3
# Offered voices (app/core/voices.py): roopa (default), ritu, simran, ishita. Any other
# speaker here or in the rotation is ignored and plays as the default voice.
SARVAM_TTS_SPEAKER=roopa
# The voices this backend offers instead of those four (Call Flows voice picker, rotation,
# Listen): comma-separated Bulbul speaker ids, each optionally id:gender, e.g.
# kavitha:female,mani:male. Default voice = SARVAM_TTS_SPEAKER when listed, else the first.
# Empty = roopa, ritu, simran, ishita (they speak every language).
SARVAM_TTS_VOICES=
SARVAM_TTS_PACE=1.0
# Comma-separated speakers rotated per call (empty = SARVAM_TTS_SPEAKER)
SARVAM_TTS_VOICE_ROTATION=roopa,ritu,simran,ishita
# concurrent = every call uses SARVAM_TTS_SPEAKER; calls running at the same time get other
# rotation voices not in use. round_robin = each new call takes the next voice in the list.
VOICE_ROTATION_MODE=concurrent

# ----- LLM -----
# gemini | openai | groq | sarvam | ollama | openai_compatible
LLM_PROVIDER=sarvam
LLM_API_KEY=
# e.g. a current Gemini Flash model id from https://ai.google.dev/gemini-api/docs/models
LLM_MODEL=sarvam-105b-conversations
# Only for openai_compatible / self-hosted endpoints
LLM_BASE_URL=
# Gemini thinking depth: minimal | low | medium | high (minimal = fastest replies on calls)
LLM_THINKING_LEVEL=minimal
# Backup model used for a reply if LLM_MODEL is over quota / overloaded (separate quota)
LLM_FALLBACK_MODEL=sarvam-105b
# After LLM_MODEL hits quota / overload, try the backup model first for this many seconds (0 = off)
LLM_PRIMARY_COOLDOWN_SECONDS=120
# Switch to the backup model if LLM_MODEL sends no reply text within this many seconds (0 = off)
LLM_PRIMARY_FIRST_TOKEN_TIMEOUT_SECONDS=2.5
# Faster model for live call replies only (empty = LLM_MODEL); LLM_MODEL becomes its fallback
LLM_TURN_MODEL=
# 0 = off. If the first model sends nothing for this many seconds, also start the second and
# speak whichever answers first (replaces the first-token timeout; extra tokens on slow turns)
LLM_HEDGE_AFTER_SECONDS=0
# Start the LLM while the TTS websocket is still connecting
LLM_START_BEFORE_TTS=true

# ----- Latency: provider connections -----
# Keep HTTPS connections to Sarvam / the LLM open between turns (seconds)
PROVIDER_KEEPALIVE_SECONDS=60
# Open those connections at call connect / speech start (no API key is sent)
PROVIDER_PREWARM=true
# Stream customer audio to Sarvam STT while they speak (falls back to the REST request)
STT_STREAMING=false
STT_STREAM_FINAL_TIMEOUT_MS=1500

# ----- MySQL -----
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=kagzso_voice
MYSQL_USER=root
MYSQL_PASSWORD=

# ----- Call behaviour -----
# The one language this backend calls in (en, ta, hi, kn, te, ml, mr, gu, bn, pa, od). One backend
# per language: another language runs this same code with its own .env.<code> (its own CALL_LANGUAGE,
# APP_PORT, MYSQL_DATABASE; PUBLIC_BASE_URL = this one + /<code>); `npm run voice:lang:plan -- ta` at the
# repo root makes one.
# It only accepts call flows in this language, and every call stays in it from start to end.
CALL_LANGUAGE=en
MAX_CALL_DURATION_SECONDS=180
# A call that hears nothing from Plivo / Twilio (not even "ringing") this long after dialling is
# marked failed with the reason (the provider can't reach PUBLIC_BASE_URL). 0 = off.
NO_PROVIDER_CALLBACK_SECONDS=120
GREETING_DELAY_MS=800
# Opening "Hi sir, Good morning." - time zone for the greeting, title when gender is missing,
# and the pause after it before "Am I speaking with ...?" (any reply asks it at once)
CALL_GREETING_TIMEZONE=Asia/Kolkata
CALL_DEFAULT_TITLE=sir
GREETING_WAIT_SECONDS=1.0
# Silence after "Am I speaking with ...?": repeat it once after this many seconds, then
# "Hello, can you hear me?" after the same wait again (then the normal silence close)
IDENTITY_SILENCE_WAIT_SECONDS=2.0
# Start of the call (time-of-day openings): listen this long (2.0-4.0 s) for the customer to
# speak first, then greet; any words play the greeting at once
FIRST_SPEECH_WAIT_SECONDS=3.0
# Speaking speed of the greeting only (0.5-2.0); every other line uses SARVAM_TTS_PACE
GREETING_TTS_SPEED=0.95
# Noise reduction on the customer's audio before speech detection (false = off, original audio)
NOISE_SUPPRESSION_ENABLED=true
# 0 (lightest) to 1; 0.5 = mild (at most 12 dB of reduction)
NOISE_SUPPRESSION_STRENGTH=0.5
# What speech-to-text hears: original (recommended) or cleaned
NOISE_SUPPRESSION_STT_AUDIO=original
# A caller who pauses mid-sentence gets this end-of-speech wait for the rest of the call (0 = off)
SLOW_SPEAKER_END_SILENCE_MS=1600
# Plivo answering-machine verdicts are checked against what STT heard before hanging up
# (false = hang up on Plivo's verdict at once, as before)
MACHINE_DETECTION_VERIFY=true
MACHINE_VERIFY_SECONDS=3.0
# Synthesize the fixed lines (couldn't-hear-you, silence re-prompt/closing, identity re-ask) once per call
PRERENDER_FIXED_LINES=true
# Silence after the agent speaks: re-prompt once, then close politely
SILENCE_REPROMPT_SECONDS=7
# true ONLY if your team really follows up interested leads (agent may then say "Our team will get in touch with you")
TEAM_FOLLOWUP_ENABLED=false
# Plivo voicemail / answering-machine detection
PLIVO_MACHINE_DETECTION=true

# ----- Turn taking (tune for your line quality) -----
VAD_AGGRESSIVENESS=2
VAD_SPEECH_START_MS=200
# Silence that ends the customer's turn. Lower (500-550) = faster replies, but customers who
# pause mid-sentence ("my number is... 98") get cut off. Change in small steps.
VAD_SPEECH_END_SILENCE_MS=700
VAD_MIN_UTTERANCE_MS=250
VAD_MIN_RMS=300

# ----- Barge-in (customer talking over the agent) -----
# Ignore speech for this long after the agent starts talking (phone echo)
BARGE_IN_GRACE_MS=800
# Loud speech this long interrupts immediately; shorter speech interrupts only if STT hears words
BARGE_IN_MIN_SPEECH_MS=1200
BARGE_IN_MIN_RMS=600

# ----- Background noise (each line can be switched off) -----
# Noise can't change the call: greeting still plays after a noise burst; silence re-prompt and
# the end-of-call flag only change once STT hears real words
NOISE_SAFE_STATE=true
# Ignore the agent's own voice coming back (3+ of its words, in order). Never affects short answers.
ECHO_TEXT_FILTER=true
ECHO_TAIL_MS=1500
# Immediate interruption needs BARGE_IN_MIN_SPEECH_MS of loud speech in one run (gaps <= max gap)
BARGE_IN_CONSECUTIVE=true
BARGE_IN_MAX_GAP_MS=100
# Energy gate follows the line's own noise level (x multiplier), capped so quiet speakers are heard
VAD_ADAPTIVE_FLOOR=true
VAD_FLOOR_MULTIPLIER=2.5
VAD_FLOOR_MAX_RMS=1000
# Drop transcripts that are only punctuation or "uh / um / er / ah" (never yes / no / okay / hello / hmm)
STT_DROP_NOISE_TEXT=true

# ----- Customer voice focus -----
# Only the customer's real speech becomes a turn: never breath / line noise, a lone "ம்" / "uh",
# noise heard while the agent talks, or the agent's own echo. Short real answers ("ஆமா", "Yes")
# right after a question still count, quiet ones too.
#   off       today's behaviour
#   balanced  moderate thresholds, soft voices still heard (default)
#   strict    noisy places: quiet speakers are missed more often and asked to speak up more often
VOICE_FOCUS_LEVEL=balanced
# log = measure every turn and log "Voice focus: ... -> counts / would drop (reason)", drop nothing
# enforce = drop what fails. Run test calls in log mode first and set thresholds from those lines.
VOICE_FOCUS_MODE=log
# Optional per-threshold overrides of the level (empty = the level's value; balanced / strict):
# voiced speech needed (280/360 ms) and speech level over the line's noise floor (6/10 dB)
VOICE_FOCUS_MIN_VOICED_MS=
VOICE_FOCUS_MIN_SNR_DB=
# ...for a short answer right after the agent asked something (200/240 ms, 4/6 dB)
VOICE_FOCUS_SHORT_VOICED_MS=
VOICE_FOCUS_SHORT_SNR_DB=
# ...for speech while the agent is talking (400/600 ms, 10/14 dB)
VOICE_FOCUS_BARGE_VOICED_MS=
VOICE_FOCUS_BARGE_SNR_DB=
# speech starting this soon after the agent stopped must be clearly above the floor (150/300 ms)
VOICE_FOCUS_AGENT_END_GUARD_MS=
# speech with a voice's pitch needed (60/100 ms): breath, coughs and clatter have none
VOICE_FOCUS_MIN_PITCHED_MS=
# Drop transcripts below this STT confidence (0 = off). Unused with Sarvam: it reports only how
# sure it is of the language, not of the words.
VOICE_FOCUS_MIN_STT_CONFIDENCE=0
# STT_NORMALIZE_AUDIO never boosts an utterance with less voiced speech than this (ms)
VOICE_FOCUS_NO_GAIN_UNDER_MS=400

# ----- Call recording (off by default) -----
# Stereo WAV per answered call: left = customer, right = only the agent audio that actually played.
# Before switching it on: make sure your consent / notice process covers recording, set a recording
# notice in each call flow (spoken right after the greeting), and check free disk space
# (about 1.9 MB per call minute).
CALL_RECORDING_ENABLED=false
# Private directory OUTSIDE the project (created 0700, files 0600), e.g. /var/lib/kagzso/recordings
RECORDINGS_DIR=
# Completed recordings older than this are deleted hourly (0 = keep forever).
RECORDING_RETENTION_DAYS=90
# Recording stops (the call doesn't) after this many seconds.
RECORDING_MAX_SECONDS=900
# Optional encryption at rest (AES-256-GCM): base64 of 32 random bytes. Keep a copy - without it
# encrypted recordings can't be played. Generate: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
RECORDING_ENCRYPTION_KEY=
