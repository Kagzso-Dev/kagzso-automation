{
  "about": "Guided flow validation cases, run by BOTH validators: tests/test_guided_flow_schema.py (app/flows/guided.py) and apps/api/test/guidedFlows.test.ts (packages/shared/src/guidedFlows.ts). Each case edits the example flow (app/flows/guided_examples/business_executive.en.json) and lists the exact set of issue codes expected. ops: set / delete / append / insert at a dotted path (list indexes are numbers).",
  "cases": [
    {"name": "the example flow is valid", "ops": [], "codes": []},
    {"name": "version 1 is not a guided flow", "ops": [{"op": "set", "path": "schema_version", "value": 1}], "codes": ["schema"]},
    {"name": "unknown top-level key", "ops": [{"op": "set", "path": "blocks", "value": []}], "codes": ["schema"]},
    {"name": "unknown intent", "ops": [{"op": "set", "path": "stages.0.next.0.when.intent", "value": ["happy"]}], "codes": ["schema"]},
    {"name": "bad closing id", "ops": [{"op": "set", "path": "closings.Bad-Id", "value": {"text": "Bye.", "outcome": "completed"}}], "codes": ["schema"]},
    {"name": "no stages", "ops": [{"op": "set", "path": "stages", "value": []}], "codes": ["schema"]},
    {"name": "a stage without transitions", "ops": [{"op": "set", "path": "stages.2.next", "value": []}], "codes": ["schema"]},
    {"name": "unknown language", "ops": [{"op": "set", "path": "language", "value": "xx"}], "codes": ["schema"]},
    {"name": "English with a language style", "ops": [{"op": "set", "path": "language_style", "value": "mixed"}], "codes": ["language_style"]},
    {"name": "identity question without the name", "ops": [{"op": "set", "path": "identity.question", "value": "Is this the owner?"}], "codes": ["identity_needs_name"]},
    {"name": "unknown start", "ops": [{"op": "set", "path": "start", "value": "nowhere"}], "codes": ["unknown_start"]},
    {"name": "duplicate stage id", "ops": [{"op": "set", "path": "stages.2.id", "value": "discover"}], "codes": ["duplicate_stage", "unknown_target"]},
    {"name": "transition to a missing stage", "ops": [{"op": "set", "path": "stages.0.next.0.go", "value": "nowhere"}], "codes": ["unknown_target"]},
    {"name": "transition to a missing closing", "ops": [{"op": "set", "path": "stages.2.next.0.go", "value": "close:nowhere"}], "codes": ["unknown_target"]},
    {"name": "retry fallback to a missing closing", "ops": [{"op": "set", "path": "stages.1.retries.then", "value": "close:nowhere"}], "codes": ["unknown_target"]},
    {"name": "a required closing is missing", "ops": [{"op": "delete", "path": "closings.busy"}], "codes": ["missing_closing"]},
    {"name": "a stage nobody reaches", "ops": [{"op": "append", "path": "stages", "value": {"id": "orphan", "objective": "Never reached.", "next": [{"go": "close:end_request"}]}}], "codes": ["unreachable_stage"]},
    {"name": "a default rule before other rules", "ops": [{"op": "insert", "path": "stages.0.next", "index": 0, "value": {"go": "discover"}}], "codes": ["unreachable_rule"]},
    {"name": "the same field in two stages", "ops": [{"op": "append", "path": "stages.2.collect", "value": {"field": "business_type", "question": "What is your business?"}}], "codes": ["duplicate_field"]},
    {"name": "a sensitive custom field", "ops": [{"op": "set", "path": "stages.1.collect.3.field", "value": "custom_phone_number"}], "codes": ["forbidden_field"]},
    {"name": "a runner-owned field", "ops": [{"op": "set", "path": "stages.1.collect.3.field", "value": "meeting_requested"}], "codes": ["forbidden_field"]},
    {"name": "a field that is neither standard nor custom_", "ops": [{"op": "set", "path": "stages.1.collect.3.field", "value": "budget"}], "codes": ["forbidden_field"]},
    {"name": "a condition on a field nobody collects", "ops": [{"op": "insert", "path": "stages.1.next", "index": 0, "value": {"when": {"field_set": "custom_budget"}, "go": "relate"}}], "codes": ["unknown_condition_field"]},
    {"name": "a knowledge topic not in training", "ops": [{"op": "append", "path": "stages.0.knowledge", "value": "warranty"}], "codes": ["unknown_knowledge"]},
    {"name": "knowledge without training", "ops": [{"op": "delete", "path": "training"}], "codes": ["unknown_knowledge"]},
    {"name": "do-not-call routed to a stage", "ops": [{"op": "insert", "path": "stages.0.next", "index": 0, "value": {"when": {"intent": ["do_not_call"]}, "go": "close:not_interested"}}], "codes": ["safety_override"]},
    {"name": "a refusal routed to more conversation", "ops": [{"op": "insert", "path": "stages.0.next", "index": 0, "value": {"when": {"intent": ["not_interested"]}, "go": "discover"}}], "codes": ["refusal_continues"]},
    {"name": "a disclosure that does not say AI", "ops": [{"op": "set", "path": "disclosures.ai", "value": "I'm calling from Kexo."}], "codes": ["disclosure_not_ai"]},
    {"name": "the end-call marker in a statement", "ops": [{"op": "set", "path": "stages.0.mandatory.0.text", "value": "Thank you. [[END_CALL]]"}], "codes": ["end_call_marker"]},
    {"name": "an unknown variable", "ops": [{"op": "set", "path": "stages.0.mandatory.0.text", "value": "We will call {{phone_number}}."}], "codes": ["unknown_variable"]},
    {"name": "a phone number in a question", "ops": [{"op": "set", "path": "stages.1.collect.0.question", "value": "Can I reach you on 98765 43210?"}], "codes": ["personal_data"]},
    {"name": "an email in a closing", "ops": [{"op": "set", "path": "closings.busy.text", "value": "Write to sales@example.com. Have a nice day."}], "codes": ["personal_data"]},
    {"name": "another website", "ops": [{"op": "set", "path": "closings.busy.text", "value": "Visit example.com. Have a nice day."}], "codes": ["link"]},
    {"name": "kagzso.com is allowed", "ops": [{"op": "set", "path": "closings.busy.text", "value": "Details are on kagzso.com. Have a nice day."}], "codes": []},
    {"name": "a price in a statement", "ops": [{"op": "set", "path": "stages.0.mandatory.0.text", "value": "Our plan costs Rs 5000 only."}], "codes": ["price"]},
    {"name": "a promised meeting in a closing", "ops": [{"op": "set", "path": "closings.meeting.text", "value": "We will schedule a meeting with you."}], "codes": ["promise"]},
    {"name": "a guarantee in a question", "ops": [{"op": "set", "path": "stages.2.collect.0.question", "value": "We guarantee results. Interested?"}], "codes": ["promise"]},
    {"name": "team follow-up said outside team_followup_text", "ops": [{"op": "set", "path": "closings.interested.text", "value": "Thank you. Our team will contact you soon."}], "codes": ["team_followup_in_text"]},
    {"name": "guidance may mention prices (not spoken)", "ops": [{"op": "set", "path": "stages.1.guidance", "value": "Never quote rupees or a discount."}], "codes": []},
    {"name": "several issues at once", "ops": [{"op": "delete", "path": "closings.no_response"}, {"op": "set", "path": "start", "value": "nowhere"}, {"op": "set", "path": "disclosures.ai", "value": "Hello."}], "codes": ["disclosure_not_ai", "missing_closing", "unknown_start"]}
  ]
}
